# ================================================================
# Rush Deal 로컬 환경변수 템플릿
# 이 파일을 복사해서 .env로 만든 뒤 빈 값을 채워주세요.
# 민감 정보(JWT, PortOne 키 등)는 팀 노션을 참고하세요.
# ================================================================

# --- Database ---
# docker-compose-app.yml 기준 컨테이너 네트워크 내부 주소
DB_URL=jdbc:postgresql://rushdeal_postgres:5432/rushdeal
DB_USERNAME=rushdeal
DB_PASSWORD=rushdeal

# --- Redis ---
# 로컬 Redis 컨테이너는 비밀번호 없음 (운영은 rushcrew)
AUTH_REDIS_HOST=rushdeal_auth_redis
AUTH_REDIS_PORT=6378
REDIS_PASSWORD=

USER_REDIS_HOST=rushdeal_user_redis
USER_REDIS_PORT=6379

QUEUE_REDIS_HOST=rushdeal_queue_redis
QUEUE_REDIS_PORT=6380

ORDER_REDIS_HOST=rushdeal_order_redis
ORDER_REDIS_PORT=6381

TIMEDEAL_REDIS_HOST=rushdeal_timedeal_redis
TIMEDEAL_REDIS_PORT=6382

# --- MinIO (S3-호환 이미지 스토리지) ---
MINIO_ROOT_USER=rushdeal
MINIO_ROOT_PASSWORD=rushdeal123
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_BUCKET=rushdeal-products

# --- Kafka ---
KAFKA_BROKERS=kafka:29092

# --- Eureka ---
EUREKA_ENABLED=true
EUREKA_URL=http://discovery-service:8761/eureka/

# --- JWT (팀 노션 참고) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRED=60480000
JWT_REFRESH_EXPIRED=120960000

# --- PortOne 결제 (팀 노션 참고) ---
PORTONE_API_SECRET=
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_WEBHOOK=

# --- Spring ---
SPRING_PROFILES_ACTIVE=local

# --- JPA ---
JPA_DDL_AUTO=update
SHOW_SQL=false
SQL_INIT_MODE=never

# --- Quartz ---
QUARTZ_INIT_SCHEMA=never
QUARTZ_THREAD_COUNT=10

# --- Auth ---
AUTH_MAX_CONCURRENT_SESSIONS=3

# --- Server Ports ---
AUTH_SERVER_PORT=8000
PAYMENT_SERVER_PORT=8010
PRODUCT_SERVER_PORT=8020
TIMEDEAL_SERVER_PORT=8030
QUEUE_SERVER_PORT=8040
ORDER_SERVER_PORT=8050
USER_SERVER_PORT=8060

# --- Monitoring ---
ZIPKIN_URL=http://zipkin:9411/api/v2/spans
MANAGEMENT_ZIPKIN_TRACING_ENDPOINT=http://zipkin:9411/api/v2/spans
TRACING_SAMPLING_RATE=1.0
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=rushcrew2025
